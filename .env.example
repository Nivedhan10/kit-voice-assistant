# Knotopian Institute of Technology (KIT) Voice Assistant Environment Configuration
# Placeholders only - NEVER commit real keys to version control.

# College System API (Required)
COLLEGE_API_KEY=your_college_participant_key_here
COLLEGE_API_BASE_URL=https://ht.knowvally.com

# AI Provider API Keys (Free tier supported)
# 1. Groq (Primary STT & LLM - console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 2. Google Gemini (Fallback LLM - aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# 3. OpenAI (Optional tertiary cloud backup)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Configuration
PRIMARY_LLM_MODEL=openai/gpt-oss-120b
FALLBACK_LLM_MODEL=openai/gpt-oss-20b
PRIMARY_STT_MODEL=whisper-large-v3-turbo
FALLBACK_STT_MODEL=whisper-large-v3
TTS_PROVIDER=edge_tts
EDGE_TTS_VOICE=en-US-JennyNeural

# Security & Session Settings
SESSION_SECRET_KEY=generate_with_python_secrets_token_urlsafe_48
SESSION_COOKIE_NAME=kit_session_id
SESSION_MAX_AGE_SECONDS=28800
COOKIE_SECURE=false

# Persistence (SQLite for local/test, PostgreSQL connection string for production)
# Neon PostgreSQL pooled connection string example:
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./kit_assistant.db

# College Academic Rules & Thresholds (Handbook 2026 & Circular 12/2026)
MIN_ATTENDANCE_PERCENT=75.0
MAX_OD_DAYS_PER_SEMESTER=10
OD_PROOF_DEADLINE_DAYS=3
